{
  "name": "instagram-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,chat-ws,chat-api -c blue,magenta,cyan \"next dev\" \"tsx src/modules/chat/server/chat-ws.ts\" \"tsx src/modules/chat/server/hono-server.ts\"",
    "dev:next": "next dev",
    "dev:chat-ws": "tsx src/modules/chat/server/chat-ws.ts",
    "dev:chat-api": "tsx src/modules/chat/server/hono-server.ts",
    "db:ensure-chat": "prisma db execute --file prisma/ensure_message_table.sql",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@tanstack/react-query": "^5.90.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@uploadthing/react": "^7.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "hono": "^4.12.7",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "pg": "^8.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-media-recorder": "^1.7.2",
    "swiper": "^12.1.3",
    "uploadthing": "^7.7.4",
    "ws": "^8.18.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
